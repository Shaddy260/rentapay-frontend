# Copy this file to .env and fill in real values.
# cp .env.example .env

# Backend API base URL. Leave unset in dev - Vite proxies /api/* to
# http://localhost:5000 (see vite.config.js).
VITE_API_BASE_URL=

# Hidden admin route (blueprint 13.3). Must start with '/'. Set your
# own value before deploying - never ship the fallback in App.jsx to production.
VITE_ADMIN_PATH=

# Sentry error tracking (optional).
VITE_SENTRY_DSN=

# --- Google Login (item 2: "Google / Facebook login") ---
# The SAME OAuth 2.0 Client ID used for GOOGLE_CLIENT_ID on the backend
# (console.cloud.google.com -> APIs & Services -> Credentials).
# This value is not secret - it's meant to be visible in the browser
# bundle, which is why only the Client ID (never the Client Secret)
# belongs on the frontend.
VITE_GOOGLE_CLIENT_ID=
