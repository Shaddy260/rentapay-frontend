# RentaPay frontend — build-time environment variables (Vite)
#
# Generated directly from every `import.meta.env.*` reference in src/,
# since no .env.example shipped with this project. These are baked in
# at build time (not runtime) - set them in your hosting provider's
# build environment, not just a local .env file, or a production build
# will silently fall back to defaults.

# Backend API base URL. Falls back to a relative /api if unset, which
# only works when the frontend and backend share an origin.
VITE_API_BASE_URL=https://api.rentapay.co.ke/api

# Google Sign-In client ID (optional - omit to hide the Google login button).
VITE_GOOGLE_CLIENT_ID=

# Sentry DSN for frontend error tracking (optional).
VITE_SENTRY_DSN=

# Overrides the default installable-PWA path for the admin portal.
# Must start with a leading slash. Keep in sync with any server-side
# admin route path. Defaults to /admin-portal-access-secret if unset.
VITE_ADMIN_PATH=/admin-portal-access-secret

# Overrides the default installable-PWA path for the General Manager
# portal. Defaults to /manager-account if unset.
VITE_MANAGER_PATH=/manager-account

# Set automatically by your build pipeline (e.g. git SHA or timestamp) -
# used by UpdateChecker.jsx to detect when a deployed tab is running a
# stale build. Leave unset locally.
VITE_BUILD_ID=
