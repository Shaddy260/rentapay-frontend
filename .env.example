# RentaPay frontend - environment variables
# Copy this file to .env (or .env.local) and fill in real values.
# All VITE_-prefixed vars are baked into the client bundle at build
# time and are PUBLIC - never put secrets here.

# Base URL of the backend API. Leave unset in local dev to use Vite's
# proxy (see vite.config.js, which forwards /api/* to
# http://localhost:5000). Set to the deployed backend's origin +
# "/api" for staging/production builds, e.g.
# https://api.rentapay.co.ke/api
VITE_API_BASE_URL=

# Secret, unlinked path for the Super Admin portal (blueprint 13.3).
# Must start with "/". Defaults to /admin-portal-access-secret if
# unset - see scripts/write-admin-path.js. Pick your own value and
# keep it out of anything public (no links to it in the UI).
VITE_ADMIN_PATH=/admin-portal-access-secret

# Google Sign-In client ID (must match GOOGLE_CLIENT_ID on the backend).
VITE_GOOGLE_CLIENT_ID=

# Error tracking (Sentry) - optional, frontend crash reporting.
VITE_SENTRY_DSN=
